# Copy to .streamlit/secrets.toml (never commit the real file).
# Everything here is optional: keys can also be set on the Settings page
# or with the VT_API_KEY / ABUSEIPDB_API_KEY / SHODAN_API_KEY environment variables.

[apikeys]
VT = "your_virustotal_api_key"
AbuseIPDB = "your_abuseipdb_api_key"
Shodan = "your_shodan_api_key"

# Optional: users defined outside the app database (useful on Streamlit Cloud).
# Generate a hash with:  python -m tia.auth
[credentials]
users = [
  { username = "analyst", role = "admin", password_hash = "pbkdf2_sha256$260000$<salt>$<hash>" },
]
